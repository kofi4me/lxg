{
  "name": "lxg",
  "compatibility_date": "2026-10-10",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "main": "worker/index.mjs",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lxg-registrations"
    }
  ]
}
